# ==============================================================================
# ECOPARK CAMEROUN (YAOUNDÉ – AHALA) — CONFIGURATION ENVIRONNEMENT V2 (REACT 19)
# ==============================================================================
# Par défaut, l'application fonctionne à 100 % en mode autonome hors-ligne
# (localStorage sous l'espace de noms `eco_park_ahala_v2_*`).
#
# Pour activer optionnellement la synchronisation Supabase PostgreSQL / Realtime
# avec le schéma `supabase/migrations/` :
#   1. Copiez ce fichier vers `.env.local` (ignoré par Git)
#   2. Renseignez l'URL et la clé publique Anon de votre projet Supabase :

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_publique_anon_ici
