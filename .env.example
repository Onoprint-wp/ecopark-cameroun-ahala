# ==============================================================================
# ECOPARK Cameroun — Configuration locale API Higgsfield (NE PAS COMMITER .env)
# ==============================================================================
# 1. Copiez ce fichier vers `.env` :
#      Copy-Item .env.example .env
# 2. Generez vos identifiants API sur : https://console.higgsfield.ai
# 3. Renseignez votre Key ID et votre Key Secret ci-dessous :

HF_API_KEY_ID=votre_key_id_ici
HF_API_KEY_SECRET=votre_key_secret_ici

# Format combine alternatif egalement reconnu par scripts/higgsfield_api.py
# et par le SDK Python officiel `higgsfield-client` :
# HF_KEY=votre_key_id_ici:votre_key_secret_ici
